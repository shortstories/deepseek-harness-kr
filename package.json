{
  "name": "deepseek-harness-kr",
  "version": "0.8.2",
  "description": "DeepSeek쟝 Plugin for DSH with KR — 한국어 UI, 파스텔 테마 및 Live2D 캐릭터",
  "type": "module",
  "license": "MIT",
  "main": "./plugin/host.js",
  "exports": {
    ".": "./plugin/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/host.js",
    "plugin/app-icon.js",
    "plugins/dsh-tts/src/cache.js",
    "plugins/dsh-tts/src/config.js",
    "plugins/dsh-tts/src/host.js",
    "plugins/dsh-tts/src/index.js",
    "plugin/chat-config.js",
    "plugin/chat-host.js",
    "plugin/pet-host.js",
    "shared/settings.js",
    "lib/client.js",
    "assets/",
    "pet/",
    "cordis.patch.yml",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node plugin/build.mjs",
    "test": "node --test plugin/test/*.test.js plugins/dsh-tts/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "trace:diff": "node plugin/test/trace/harness.mjs --diff",
    "locales": "node plugin/locales.mjs report"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "devDependencies": {
    "@electron/asar": "^3.2.17",
    "@types/node": "24.10.1",
    "@types/react": "18.3.26",
    "acorn": "^8.15.0",
    "esbuild": "0.25.11",
    "jsdom": "^27.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
