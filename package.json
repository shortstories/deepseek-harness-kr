{
  "name": "deepseek-harness-kr",
  "version": "0.7.6",
  "description": "DeepSeek Harness 한국어 UI, 파스텔 테마 및 DeepSeek짱 Live2D 캐릭터",
  "type": "module",
  "license": "MIT",
  "main": "./plugin/host.js",
  "exports": {
    ".": "./plugin/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/host.js",
    "plugin/app-icon.js",
    "plugin/chat-config.js",
    "plugin/chat-host.js",
    "plugins/dsh-tts/src/cache.js",
    "plugins/dsh-tts/src/config.js",
    "plugins/dsh-tts/src/host.js",
    "plugins/dsh-tts/src/index.js",
    "plugin/pet-host.js",
    "lib/client.js",
    "assets/",
    "pet/",
    "cordis.patch.yml",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node plugin/build.mjs",
    "test": "node --test plugin/test/*.test.js plugins/dsh-tts/test/*.test.js",
    "locales:extract": "node plugin/extract-locales.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "devDependencies": {
    "@electron/asar": "^3.2.17",
    "acorn": "^8.15.0",
    "jsdom": "^27.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
